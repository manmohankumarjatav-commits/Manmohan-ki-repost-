}

.gift-message{
    display:none;
    animation:pop .7s ease;
}

@keyframes pop{
    from{
        opacity:0;
        transform:scale(.7);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}

/* ---------- FINAL ---------- */

.final-heart{
    font-size:90px;
    animation:pulse 1.4s infinite;
}

@keyframes pulse{
    50%{transform:scale(1.15)}
}

/* ---------- NAV ---------- */

.nav{
    position:fixed;
    bottom:18px;
    left:50%;
    transform:translateX(-50%);
    z-index:100;
    display:flex;
    gap:10px;
}

.nav button{
    width:48px;
    height:48px;
    border:0;
    border-radius:50%;
    background:#9d214c;
    color:white;
    font-size:18px;
    cursor:pointer;
    box-shadow:0 7px 20px #8b1c3d44;
}

.progress{
    position:fixed;
    top:0;
    left:0;
    height:4px;
    background:#9d214c;
    width:0;
    z-index:200;
    transition:.4s;
}

/* ---------- MOBILE ---------- */

@media(max-width:650px){

    .photo-grid{
        grid-template-columns:1fr;
    }

    .photo-card:nth-child(1),
    .photo-card:nth-child(2),
    .photo-card:nth-child(3){
        transform:none;
    }

    .photo-card img{
        height:430px;
    }

    .glass{
        padding:30px 16px;
    }

    .letter-text{
        font-size:19px;
    }
}
</style>
</head>

<body>

<div class="progress" id="progress"></div>
<div class="particles" id="particles"></div>


<!-- SCREEN 1 -->

<section class="screen active">

<div class="content">

<div class="rakhi">🎀</div>

<div class="small">
A little surprise
</div>

<h1 class="title">
Khushi ❤️
</h1>

<p class="subtitle">
Is Raksha Bandhan par<br>
tumhare liye kuch special banaya hai...
</p>

<button class="btn" onclick="nextScreen()">
Open My Surprise ✨
</button>

</div>

</section>


<!-- SCREEN 2 -->

<section class="screen">

<div class="content glass">

<div class="rakhi">
🪢
</div>

<h1 class="title">
Happy Raksha Bandhan
</h1>

<p class="subtitle">
Khushi, kuch relationships<br>
blood se nahi, memories se special bante hain. ❤️
</p>

<p class="hand">
Aur tu unhi special logon mein se hai.
</p>

<button class="btn" onclick="nextScreen()">
Continue 💗
</button>

</div>

</section>


<!-- SCREEN 3 -->

<section class="screen">

<div class="content">

<div class="small">
Our Memories
</div>

<h1 class="title">
Humari Yaadein 📸
</h1>

<div class="photo-grid">

<div class="photo-card">
<img src="photo1.jpg">
</div>

<div class="photo-card">
<img src="photo2.jpg">
</div>

<div class="photo-card">
<img src="photo3.jpg">
</div>

</div>

<p class="memory">
Photos purani ho sakti hain...<br>
memories kabhi purani nahi hoti. ❤️
</p>

<button class="btn" onclick="nextScreen()">
Next ✨
</button>

</div>

</section>


<!-- SCREEN 4 -->

<section class="screen">

<div class="content glass">

<div class="small">
Some promises
</div>

<h1 class="title">
Bhai Ke Promises 🤞
</h1>

<p class="subtitle">
Neeche wale cards par tap karna ❤️
</p>

<div class="promise-list">

<div class="promise" onclick="togglePromise(this)">
🫂 <b>Promise #1</b>
<div class="hidden">
Chahe kitni bhi nok-jhok ho,
main hamesha tere side rahunga.
</div>
</div>

<div class="promise" onclick="togglePromise(this)">
😂 <b>Promise #2</b>
<div class="hidden">
Teri bakwaas sunne ke liye
main available rahunga. 😂
</div>
</div>

<div class="promise" onclick="togglePromise(this)">
🛡️ <b>Promise #3</b>
<div class="hidden">
Jab bhi zarurat ho,
tera bhai tere saath khada milega.
</div>
</div>

<div class="promise" onclick="togglePromise(this)">
❤️ <b>Promise #4</b>
<div class="hidden">
Ye bond hamesha special rahega.
</div>
</div>

</div>

<button class="btn" onclick="nextScreen()">
Ek Aur Surprise 💌
</button>

</div>

</section>


<!-- SCREEN 5 -->

<section class="screen">

<div class="content">

<div class="small">
A letter for you
</div>

<h1 class="title">
Bhai Ki Chitthi 💌
</h1>

<p class="subtitle">
Envelope par tap karo...
</p>

<div class="envelope-area">

<div class="envelope" onclick="openEnvelope(this)">

<div class="letter">

<div class="letter-text">

Dear Khushi ❤️

<br><br>

Tu meri bua ki ladki zaroor hai,
lekin mere liye ek proper sister jaisi hai.

<br><br>

Hamari masti aur memories
hamesha special rahengi.

<br><br>

— Tera Bhai 🫂

</div>

</div>

</div>

</div>

<button class="btn" onclick="nextScreen()">
Next 🎁
</button>

</div>

</section>


<!-- SCREEN 6 -->

<section class="screen">

<div class="content glass">

<div class="small">
Your actual gift
</div>

<h1 class="title">
🎁 Surprise
</h1>

<p class="subtitle">
Gift box kholo...
</p>

<div class="giftbox" onclick="openGift(this)">

<div class="lid"></div>

<div class="box"></div>

</div>

<div class="gift-message" id="giftMessage">

<h2>
Surprise! 🎉❤️
</h2>

<p class="subtitle">

Is baar expensive gift nahi de paaya...

<br><br>

Isliye socha kuch aisa doon
jo paise se nahi milta.

<br><br>

<strong>
Ye chhoti si website sirf tere liye. ❤️
</strong>

</p>

</div>

<button class="btn" onclick="nextScreen()">
Last One ❤️
</button>

</div>

</section>


<!-- SCREEN 7 -->

<section class="screen">

<div class="content">

<div class="final-heart">
❤️
</div>

<h1 class="title">
Khushi
</h1>

<p class="subtitle">
Hamesha khush reh,<br>
hamesha smile karti reh. 🫂
</p>

<br>

<p class="hand">
Happy Raksha Bandhan 🎀
</p>

<p class="subtitle">
<strong>
Best Sister Ever ❤️
</strong>
</p>

<button class="btn" onclick="celebrate()">
One Last Surprise 🎊
</button>

</div>

</section>


<!-- NAVIGATION -->

<div class="nav">

<button onclick="previousScreen()">
‹
</button>

<button onclick="nextScreen()">
›
</button>

</div>


<script>

let current=0;

const screens=document.querySelectorAll(".screen");

function showScreen(index){

if(index<0) index=0;

if(index>=screens.length)
index=screens.length-1;

screens.forEach((s,i)=>{
s.classList.toggle("active",i===index);
});

current=index;

document.getElementById("progress").style.width=
((index)/(screens.length-1))*100+"%";

window.scrollTo({
top:0,
behavior:"smooth"
});

}

function nextScreen(){

showScreen(current+1);

createParticles(8);

}

function previousScreen(){

showScreen(current-1);

}

function togglePromise(element){

element.classList.toggle("open");

}

function openEnvelope(el){

el.classList.toggle("open");

createParticles(15);

}

function openGift(el){

el.classList.toggle("open");

document.getElementById("giftMessage").style.display="block";

celebrate();

}

function createParticles(number){

const container=document.getElementById("particles");

for(let i=0;i<number;i++){

const p=document.createElement("div");

p.className="particle";

p.innerHTML=
["❤️","💖","✨","🌸","🎀","🪢"][Math.floor(Math.random()*6)];

p.style.left=Math.random()*100+"vw";

p.style.fontSize=
(15+Math.random()*25)+"px";

p.style.animationDuration=
(4+Math.random()*4)+"s";

container.appendChild(p);

setTimeout(()=>{
p.remove();
},8000);

}

}

function celebrate(){

createParticles(60);

}

/* automatic floating hearts */

setInterval(()=>{

createParticles(1);

},900);

</script>

</body>
</html>